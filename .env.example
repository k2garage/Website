# Required for persistent administration data (Neon / PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required to protect /dashboard (use unique, long values; never commit real secrets)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
OWNER_USERNAME=owner
OWNER_PASSWORD=change-me-too
ADMIN_SESSION_SECRET=generate-a-long-random-secret-at-least-32-characters

# Optional: image uploads via Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Optional: new inquiry notifications via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=K2 garage <noreply@k2garage.cz>
CONTACT_RECIPIENT_EMAIL=k2garage@seznam.cz

# Optional: publish a generated content snapshot to a connected GitHub repository.
# A GitHub push then triggers Vercel's automatic deployment.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repository
GITHUB_BRANCH=main
GITHUB_CONTENT_FILE=data/admin-content.json

# Fallback: a Vercel Deploy Hook URL can request a rebuild after a dashboard save.
# Keep this server-side; it is a credential.
VERCEL_DEPLOY_HOOK_URL=
